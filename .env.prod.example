# Copy to .env on the production host and replace every CHANGE_ME value.
# Never commit the resulting .env file.

FLASK_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48
SERVER_NAME=nicotinetracker.com
PREFERRED_URL_SCHEME=https
APPLICATION_ROOT=/

# A named MariaDB/MySQL-compatible database is mandatory in production.
DATABASE_URL=mysql+pymysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DB_HOST:3306/nicotine_tracker

# Shared limiter state on the production host's loopback-only Redis DB 4.
# Redis must be running and reachable before starting the app and worker.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/4

# Generate independently; do not reuse SECRET_KEY:
# Generate with: python3 -c "import secrets; print('nicotine-tracker-prod-' + secrets.token_hex(8))"
RATELIMIT_KEY_PREFIX=CHANGE_ME_GENERATE_UNIQUE_PREFIX
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RATELIMIT_HMAC_SECRET=CHANGE_ME_GENERATE_INDEPENDENT_SECRET

# Exact number of trusted reverse-proxy hops that set each header.
RATELIMIT_TRUSTED_PROXY_COUNT=1
PROXY_FIX_X_PROTO_COUNT=1

SESSION_LIFETIME=86400
WTF_CSRF_ENABLED=True

MAIL_SERVER=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_DEFAULT_SENDER=CHANGE_ME_SENDER_ADDRESS

NOTIFICATION_PROCESS_INTERVAL=30
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_CLAIM_LEASE_SECONDS=300
NOTIFICATION_DEBUG=False

LOG_TO_STDOUT=True
LOG_LEVEL=INFO
LOGS_PER_PAGE=20
